<div class="modal-header" >
    <h2>Confirm order deletion</h2>
</div>

<div class="modal-body" style="word-break: break-all; word-wrap: break-word; margin-left: 15px">
    <div class="row"><h3>Do you want to delete this order? </h3></div>
</div>


<div class="modal-footer">
    <button type="button" id="cancelShowSupplierButton" class="btn btn-danger" onclick="confirmOrderDelete()" data-dismiss="modal">Delete</button>
    <button type="button" id="saveSupplierButton" class="btn btn-secondary" onclick="cancelOrderDelete();" style="margin-left: 10px; float: left; top: 0; right: 0">No</button>
</div>
